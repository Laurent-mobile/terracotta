{
  "name": "terracotta-restaurant",
  "version": "1.0.0",
  "description": "Application web pour la gestion du restaurant",
  "type": "module",
  "dev": "vite",
  "build": "vite build",
  "preview": "vite preview",
  "lint": "eslint .",
  "typecheck": "tsc --noEmit -p tsconfig.app.json",
  "cap:android": "npx cap copy android && npx cap open android",
  "cap:ios": "npx cap copy ios && npx cap open ios",
  "cap:sync": "npx cap sync",
  "cap:copy": "npx cap copy",
  "android": "npm run build && npx cap copy android && npx cap open android",
  "ios": "npm run build && npx cap copy ios && npx cap open ios"
},
"dependencies": {
  "@capacitor/android": "^8.4.1",
  "@capacitor/app": "^8.1.0",
  "@capacitor/camera": "^8.2.0",
  "@capacitor/cli": "^7.6.7",
  "@capacitor/core": "^8.4.1",
  "@capacitor/device": "^8.0.2",
  "@capacitor/filesystem": "^8.1.2",
  "@capacitor/haptics": "^8.0.2",
  "@capacitor/ios": "^8.4.1",
  "@capacitor/keyboard": "^8.0.5",
  "@capacitor/preferences": "^8.0.1",
  "@capacitor/push-notifications": "^8.1.1",
  "@capacitor/splash-screen": "^8.0.1",
  "@capacitor/status-bar": "^8.0.2",
  "@supabase/supabase-js": "^2.57.4",
  "@types/uuid": "^10.0.0",
  "html2canvas": "^1.4.1",
  "jspdf": "^3.0.4",
  "lucide-react": "^0.344.0",
  "qrcode.react": "^4.2.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-router-dom": "^7.9.5",
  "recharts": "^3.4.1",
  "uuid": "^14.0.1"
},
"devDependencies": {
  "@eslint/js": "^9.9.1",
  "@types/react": "^18.3.27",
  "@types/react-dom": "^18.3.7",
  "@vitejs/plugin-react": "^4.3.1",
  "autoprefixer": "^10.4.18",
  "eslint": "^9.9.1",
  "eslint-plugin-react-hooks": "^5.1.0-rc.0",
  "eslint-plugin-react-refresh": "^0.4.11",
  "globals": "^15.9.0",
  "postcss": "^8.4.35",
  "tailwindcss": "^3.4.1",
  "typescript": "^5.9.3",
  "typescript-eslint": "^8.3.0",
  "vite": "^5.4.2"
}
}